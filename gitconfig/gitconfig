[user]
  email = zknsftk1msrk@gmail.com
  useConfigOnly = true
[alias]
  ci = commit
  cae = commit --allow-empty
[push]
  followTags = true
[init]
  defaultBranch = main
[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
[credential]
	helper = store
[merge]
	ff = false
[pull]
	rebase = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
  side-by-side = true
  line-numbers = true
